            <ownedFunctionalChainInvolvements xsi:type="org.polarsys.capella.core.data.fa:FunctionalChainInvolvementLink" id="0c54ead9-7c66-5e99-8bee-b81e4a83b676" involved="#8ae18f6b-36b6-4171-a5f3-fd90e46b94d2" source="#75fe8014-138f-4cba-b712-380594207cd9" target="#092070ea-d3dd-4213-93d6-80310655d6ff"/>
            <ownedFunctionalChainInvolvements xsi:type="org.polarsys.capella.core.data.fa:FunctionalChainInvolvementLink" id="d5696e65-b81d-576a-861f-83341c4e49e1" involved="#2eebc45b-f556-4db7-a412-eafee0abad9f" source="#092070ea-d3dd-4213-93d6-80310655d6ff" target="#0827ffba-30ef-49d9-84ef-34d264318459"/>
          </ownedFunctionalChains>
          <ownedFunctionalChains xsi:type="org.polarsys.capella.core.data.fa:FunctionalChain" id="2fa98abe-0bfe-4606-b84c-7dabe52436d7" name="FC-02 Active Control Update" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; One bounded control update from measurements, mode and protection inputs to seated and bed-mode secondary commands. Feedback remains explicit in the functional architecture, while execution modes and fault responses are defined in the operating-state model.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Source:&lt;/i&gt; KPR LuxAero HACC Final Technical Report (2026) and ARCADIA architecture decomposition.&lt;/p&gt;">
            <ownedFunctionalChainInvolvements xsi:type="org.polarsys.capella.core.data.fa:FunctionalChainInvolvementFunction" id="7adaca8c-61df-44e0-b527-c62bf5fef994" involved="#213f287e-b56a-416b-a5ab-108c7dd2b1cf"/>
