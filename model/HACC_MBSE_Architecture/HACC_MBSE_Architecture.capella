    <ownedArchitectures xsi:type="org.polarsys.capella.core.data.ctx:SystemAnalysis" id="4bf39873-4a8e-4cab-9759-39de5ee9c60c" name="System Analysis">
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="5c07bb51-b2d6-55f5-ae27-61df65dd1732" name="SN-01 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; Improve low-frequency acoustic comfort for VIP passengers during long-haul cruise.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); InnovAero task objective; FTR §1&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-12.&lt;/p&gt;" constrainedElements="#fc13bb70-e7a8-4687-be7b-13063c95b09e #7a73c1e3-8082-4d26-b060-3f8af6d15b54 #88649f1a-a7bc-4691-a225-e2cf07dd7ea3 #ed56a35d-d05e-4425-8536-efc40ce5b418 #1682092f-2552-50bd-826f-c3128f7c1fec #b3590c5f-3201-546e-8d29-5fbbd554f062 #647c7136-9474-41bc-ae53-14bf944bd905 #e18850cd-7348-4116-b333-17ae8169ea64">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="54bf0a20-49a5-5b1d-9792-f0838906ea6a">
          <bodies>Improve low-frequency acoustic comfort for VIP passengers during long-haul cruise.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="7111cd2d-6845-5919-89e5-3a96152d579b" name="SN-02 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; Address acoustic comfort in both seated and lie-flat passenger configurations.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); InnovAero task A5; FTR §7.4&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-07.&lt;/p&gt;" constrainedElements="#27370d90-c939-493c-96a6-6714f1def737 #1682092f-2552-50bd-826f-c3128f7c1fec #b3590c5f-3201-546e-8d29-5fbbd554f062 #69ebb290-7fe7-586c-b668-9349f176af87 #90096710-9c24-4c77-b8c0-f3e8cbf8b2bd #d05651ae-ca25-47a7-b7b9-5d63633b0091 #3245374b-507d-4f21-8475-8181600c1ec2 #a84dcf06-db26-4519-9375-95197bf381fd">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="9a53d94f-21e9-5a01-ba0b-7a3ff1ebe38a">
          <bodies>Address acoustic comfort in both seated and lie-flat passenger configurations.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="9efc4edc-6721-55db-9a3b-02d410fb5ba6" name="SYS-REQ-01 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; The HACC shall provide a fail-passive architecture such that loss or disablement of ANC retains passive acoustic protection.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §1.1; §10 Table 22&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-10.&lt;/p&gt;" constrainedElements="#c7365b1b-516a-4545-968f-bdb48bcd8e29 #d4387b3b-b67b-51ad-886e-4339e38f6275 #46dcfca1-75ad-5f0e-958a-7a87564f218b #e18850cd-7348-4116-b333-17ae8169ea64">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="f716a4c6-5f42-5425-bcda-38d66734ba65">
          <bodies>The HACC shall provide a fail-passive architecture such that loss or disablement of ANC retains passive acoustic protection.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="ed5d114c-7f4f-5529-8b71-83b32467bc19" name="SYS-REQ-02 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; The passive architecture shall provide a six-face 2.0 kg/m² barrier with melamine treatment and local dominant-bay reinforcement as defined by the selected C4 concept.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §§7,9; Table 21&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-03.&lt;/p&gt;" constrainedElements="#fc13bb70-e7a8-4687-be7b-13063c95b09e #d4387b3b-b67b-51ad-886e-4339e38f6275 #d9833754-3f40-4492-87d6-1fd57a00ccce #1021dc72-87a3-4b07-84a5-9311a1e04cbb #cc54a07b-6954-4113-9c78-58190df841f0">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="fb40882f-c301-5b97-9b97-655da7bf2518">
          <bodies>The passive architecture shall provide a six-face 2.0 kg/m² barrier with melamine treatment and local dominant-bay reinforcement as defined by the selected C4 concept.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="a2216ee3-b974-578c-9cf3-f69489d82df1" name="SYS-REQ-03 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; The controlling dominant bay shall use a fully filled 125 mm porous cavity with local CLD and +1.0 kg/m² barrier overlay.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §§6.1,7.1,9.4&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-03.&lt;/p&gt;" constrainedElements="#7a73c1e3-8082-4d26-b060-3f8af6d15b54 #cdbcae97-0911-52b5-9d2a-2918a7babd45 #a6fee6a1-b801-4b1d-af79-ff433130f763 #dc20be03-c788-47e8-9fa8-5341472ed48b #a8e9fe6d-076d-4d12-bf2f-18534123d926">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="76085460-2f42-58d8-8eb4-841dc2ade4eb">
          <bodies>The controlling dominant bay shall use a fully filled 125 mm porous cavity with local CLD and +1.0 kg/m² barrier overlay.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="a4a982e3-46af-515c-a938-5af63f1879f8" name="SYS-REQ-04 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; The cabin-side resonator cassette shall retain independently serviceable cells tuned nominally to 97 Hz, 120 Hz and 149 Hz.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §7.2&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-04.&lt;/p&gt;" constrainedElements="#88649f1a-a7bc-4691-a225-e2cf07dd7ea3 #5ca74c8e-373c-4381-9021-628282d67746 #96edbaca-46ae-5c20-a480-3560c69a8f74">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="6c63ac09-5594-53bc-b1f0-dbc518015c61">
          <bodies>The cabin-side resonator cassette shall retain independently serviceable cells tuned nominally to 97 Hz, 120 Hz and 149 Hz.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="a8b54139-52cc-514c-b942-f617d5fee611" name="SYS-REQ-05 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; The active-control architecture shall use two structural references, two secondary sources and two ear-side error microphones for the seated configuration.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §10&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-06.&lt;/p&gt;" constrainedElements="#213f287e-b56a-416b-a5ab-108c7dd2b1cf #0d9b31cf-e4fb-440c-8e4c-665184a2a265 #ed56a35d-d05e-4425-8536-efc40ce5b418 #1682092f-2552-50bd-826f-c3128f7c1fec #e02b303e-e71e-4135-8a1d-62ae74bb0bf8 #e7f593bf-675d-4cf3-8cc7-b2514753c359 #1ee0208f-c3a8-43bb-b0c2-d4bfc38f7f2d #3245374b-507d-4f21-8475-8181600c1ec2">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="3f0ec94a-ad9e-5e4a-90d5-775cc1a2338a">
          <bodies>The active-control architecture shall use two structural references, two secondary sources and two ear-side error microphones for the seated configuration.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="f8225d49-a92f-5beb-a06b-55736f33b86a" name="SYS-REQ-06 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; The active-control architecture shall support a bed-mode secondary array and automatic handover based on seat-position state.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §7.4; §10&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-07.&lt;/p&gt;" constrainedElements="#27370d90-c939-493c-96a6-6714f1def737 #b3590c5f-3201-546e-8d29-5fbbd554f062 #69ebb290-7fe7-586c-b668-9349f176af87 #90096710-9c24-4c77-b8c0-f3e8cbf8b2bd #d05651ae-ca25-47a7-b7b9-5d63633b0091 #a84dcf06-db26-4519-9375-95197bf381fd #6929117e-1255-5b49-ae5e-6d0882bcc5f3">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="083c21cf-a20d-585d-9279-c267e75b6930">
          <bodies>The active-control architecture shall support a bed-mode secondary array and automatic handover based on seat-position state.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="8afe3187-1a97-545d-8c44-b62ee1c81a33" name="SYS-REQ-07 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; Cabin crew shall be able to disable or mute the active acoustic-control layer.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §10&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-11.&lt;/p&gt;" constrainedElements="#16c41f0f-aa28-4a78-8f12-0b1c9fd6ffac #6907befd-fbad-4f97-8e86-23869abfbe23 #95ff9590-048f-4b91-9197-93cde73a1f3a #2f7990f8-c58a-5c2e-b080-952db95d9010">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="c70db210-a2ad-525f-88d4-324aaffdf3da">
          <bodies>Cabin crew shall be able to disable or mute the active acoustic-control layer.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="e5b626b0-ee92-58b1-981f-7303d37a6156" name="SYS-REQ-08 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; ANC faults shall invoke bounded safe responses including freeze, limit, mute or feedback-disable while preserving passive HACC operation.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §10 Table 22&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-08.&lt;/p&gt;" constrainedElements="#c7365b1b-516a-4545-968f-bdb48bcd8e29 #b769cb7b-af04-4804-b73d-d11c28c8aeae #1ee0208f-c3a8-43bb-b0c2-d4bfc38f7f2d #46dcfca1-75ad-5f0e-958a-7a87564f218b #2ba656a3-2f2d-5230-898b-a52271d8ce4d">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="d4d39639-783a-5cdc-a1c5-c27acfae3454">
          <bodies>ANC faults shall invoke bounded safe responses including freeze, limit, mute or feedback-disable while preserving passive HACC operation.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="d6841b9a-f563-5ae1-a52e-a2e7c185e3c6" name="SYS-REQ-09 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; The installation shall preserve inspection and maintenance access through modular treatment and replaceable service elements.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §§7.2,9&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-15.&lt;/p&gt;" constrainedElements="#fc13bb70-e7a8-4687-be7b-13063c95b09e #7a73c1e3-8082-4d26-b060-3f8af6d15b54 #88649f1a-a7bc-4691-a225-e2cf07dd7ea3 #a2e9ac0c-9e39-45a2-8f96-a1d2eb004e62 #e18850cd-7348-4116-b333-17ae8169ea64 #d4387b3b-b67b-51ad-886e-4339e38f6275 #cdbcae97-0911-52b5-9d2a-2918a7babd45 #5ca74c8e-373c-4381-9021-628282d67746 #5dc0ed5c-7f10-4b05-b73f-4dd20be30684">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="4de53bc3-93cd-51da-a3d9-88f1db8de2c8">
          <bodies>The installation shall preserve inspection and maintenance access through modular treatment and replaceable service elements.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="fe34aeb9-990b-54fe-8f60-47884a0eb3ff" name="SYS-REQ-10 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; The HACC installation shall use isolators/brackets/bonding provisions and shall not introduce direct fasteners into CFRP primary structure.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §9&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-15.&lt;/p&gt;" constrainedElements="#e18850cd-7348-4116-b333-17ae8169ea64 #d4387b3b-b67b-51ad-886e-4339e38f6275 #331c6d02-c14f-4311-b5cd-d9701ea28e58">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="c93e850d-9215-5376-8776-44cab7dc4b2f">
          <bodies>The HACC installation shall use isolators/brackets/bonding provisions and shall not introduce direct fasteners into CFRP primary structure.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="09523a50-4217-513b-8ce5-76ad615be3de" name="CON-01 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; Concept delta mass before growth is 135.0 kg passive and 147.5 kg including the active system; these are planning estimates, not frozen installation weights.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §9.4 Table 21&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-15.&lt;/p&gt;" constrainedElements="#e18850cd-7348-4116-b333-17ae8169ea64">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="6f0e57b1-275f-5114-bc19-8cc5ab36addb">
          <bodies>Concept delta mass before growth is 135.0 kg passive and 147.5 kg including the active system; these are planning estimates, not frozen installation weights.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="633e0746-6650-54a2-a850-a8e6d7caa793" name="CON-02 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; The demonstrator shall preserve the FTR distinction between screening predictions and installed/certified performance; no guaranteed active or broadband sleep-grade claim is made.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR §11 conclusions/limitations&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-12.&lt;/p&gt;" constrainedElements="#886257b0-5790-430c-a94a-826c169cb1b1 #e18850cd-7348-4116-b333-17ae8169ea64">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="95740f39-6033-5b36-8da1-a21db64798b7">
          <bodies>The demonstrator shall preserve the FTR distinction between screening predictions and installed/certified performance; no guaranteed active or broadband sleep-grade claim is made.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="e3c34ff6-c9bb-501d-a74d-de738839978f" name="VER-REQ-01 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; CFRP-HACC coupon correlation shall target agreement within ±3 dB before freezing layer order, cavity and resonator geometry.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR Table 23 G2&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-03.&lt;/p&gt;" constrainedElements="#fc13bb70-e7a8-4687-be7b-13063c95b09e #d4387b3b-b67b-51ad-886e-4339e38f6275 #cdbcae97-0911-52b5-9d2a-2918a7babd45 #5ca74c8e-373c-4381-9021-628282d67746">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="a93e4aba-7d0a-50dc-bae7-6238990e5ea8">
          <bodies>CFRP-HACC coupon correlation shall target agreement within ±3 dB before freezing layer order, cavity and resonator geometry.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="f31632a7-6065-59e2-8868-df5d97a2ef12" name="VER-REQ-02 [BASE]" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; Active seat-rig testing shall demonstrate stable attenuation in both passenger postures before flight configuration authorization.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; KPR LuxAero, HACC Final Technical Report (2026); FTR Table 23 G4&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-06.&lt;/p&gt;" constrainedElements="#ed56a35d-d05e-4425-8536-efc40ce5b418 #27370d90-c939-493c-96a6-6714f1def737 #1682092f-2552-50bd-826f-c3128f7c1fec #b3590c5f-3201-546e-8d29-5fbbd554f062 #1ee0208f-c3a8-43bb-b0c2-d4bfc38f7f2d #3245374b-507d-4f21-8475-8181600c1ec2 #a84dcf06-db26-4519-9375-95197bf381fd">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="980c1873-6d52-5fab-8b2d-120d717c1038">
          <bodies>Active seat-rig testing shall demonstrate stable attenuation in both passenger postures before flight configuration authorization.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="1bcdc135-5f22-52df-8805-9dc571234e6a" name="EXT-REQ-01 [EXT]" description="&lt;p&gt;&lt;b&gt;[EXT]&lt;/b&gt; The HACC shall provide a representative read-only health/status interface to a cabin-management system through a defined read-only boundary.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; MBSE extension&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-13.&lt;/p&gt;" constrainedElements="#7aa9ce73-ae05-4023-9825-60b983839f26 #669fed0e-3bab-4b55-a14e-105b3be98ec1 #091a994d-a0ef-41f9-a373-1135332e004b #8f3bb942-c2a6-5caf-ae57-ba7fceee213d">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="21fb7d55-8b17-5524-9f93-0fc644222e63">
          <bodies>The HACC shall provide a representative read-only health/status interface to a cabin-management system through a defined read-only boundary.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="17371696-7c3c-576f-aecf-9b5d2698f2ee" name="EXT-REQ-02 [EXT]" description="&lt;p&gt;&lt;b&gt;[EXT]&lt;/b&gt; The HACC shall provide selected maintenance diagnostic information to a representative ground-maintenance service through a defined read-only boundary.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; MBSE extension&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-14.&lt;/p&gt;" constrainedElements="#89ada3a0-11a6-492b-8573-53d0f3be693a #0caf2d1c-19c0-4259-8997-2f7bd210ef89 #0ecfffd4-4574-46b4-9a97-ddcf864d0f01 #920d5386-02fb-591f-b106-0b5dbb49f526">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="de088d2b-1eda-5140-8097-aef986825cf9">
          <bodies>The HACC shall provide selected maintenance diagnostic information to a representative ground-maintenance service through a defined read-only boundary.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint" id="6acfb39a-c39c-51be-8f0f-00659e850ce1" name="EXT-REQ-03 [EXT]" description="&lt;p&gt;&lt;b&gt;[EXT]&lt;/b&gt; Connected-cabin extensions are limited to status/diagnostic exchange and do not model proprietary CMS, SATCOM, aircraft-network implementation or certified wiring.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Source:&lt;/b&gt; MBSE scope boundary&lt;/p&gt;&lt;p&gt;&lt;b&gt;Verification:&lt;/b&gt; Planned through VC-13.&lt;/p&gt;" constrainedElements="#7aa9ce73-ae05-4023-9825-60b983839f26 #091a994d-a0ef-41f9-a373-1135332e004b #0ecfffd4-4574-46b4-9a97-ddcf864d0f01">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression" id="99857ef6-e598-527b-b4c5-6b979609d114">
          <bodies>Connected-cabin extensions are limited to status/diagnostic exchange and do not model proprietary CMS, SATCOM, aircraft-network implementation or certified wiring.</bodies>
          <languages>text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedFunctionPkg xsi:type="org.polarsys.capella.core.data.ctx:SystemFunctionPkg" id="22763b86-8e2b-4d54-aa04-45631a089d96" name="System Functions">
        <ownedSystemFunctions xsi:type="org.polarsys.capella.core.data.ctx:SystemFunction" id="08c64b28-244e-4b83-bf1e-1c1e76d8d422" name="Root System Function">
          <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue" id="aa067233-c550-5a38-b1c3-03a33fad9e92" name="Origin" value="BASE"/>
          <ownedFunctionalChains xsi:type="org.polarsys.capella.core.data.fa:FunctionalChain" id="4839f1ed-05db-4cb9-9665-a260f516a615" name="FC-01 Passive Acoustic Attenuation" description="&lt;p&gt;&lt;b&gt;[BASE]&lt;/b&gt; Connected functional flow. Branches express architecture dependencies; ANC modes, handover and fail-passive transitions are defined in the operating-state model.&lt;/p&gt;&lt;p&gt;&lt;i&gt;Source:&lt;/i&gt; KPR LuxAero HACC Final Technical Report (2026) and ARCADIA architecture decomposition.&lt;/p&gt;">
            <ownedFunctionalChainInvolvements xsi:type="org.polarsys.capella.core.data.fa:FunctionalChainInvolvementFunction" id="75fe8014-138f-4cba-b712-380594207cd9" involved="#fc13bb70-e7a8-4687-be7b-13063c95b09e"/>
