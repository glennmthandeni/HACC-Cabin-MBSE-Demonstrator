          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation" id="65d59c95-2a4f-5b30-9dcb-d29cdee49736" targetElement="#69ebb290-7fe7-586c-b668-9349f176af87" sourceElement="#647c7136-9474-41bc-ae53-14bf944bd905"/>
          <ownedStateMachines xsi:type="org.polarsys.capella.core.data.capellacommon:StateMachine" id="02b8d30b-4931-4da9-ac67-03201c46dbb2" name="ANC Operating and Fail-Passive State Machine">
            <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region" id="5f45c6a7-99e6-41e7-8a80-415fe1867b22" name="Default Region" involvedStates="#5ca77ee1-88d6-4b16-8899-09979f6432e8 #159dab7a-3d40-4e3d-b707-530c4ec9a8a2 #fff292ee-17dc-4c87-81b8-1c7ae39c9bf5 #684092ea-e41c-4706-b851-b3fe45e99624 #bffbdba2-9cd5-4e00-84ff-f18b3ed0f78d #355f8aa8-9d0e-468a-945e-3e8ab5d2c32d #5588f151-8d71-4b42-a1d0-fb4c030b0c68 #f5f200f7-ff85-46ae-898f-cc2e77b6f809">
              <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:InitialPseudoState" id="5ca77ee1-88d6-4b16-8899-09979f6432e8" name="Initial 1"/>
              <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State" id="159dab7a-3d40-4e3d-b707-530c4ec9a8a2" name="ANC Initialising" description="&lt;p&gt;[BASE] The active-control subsystem performs startup and health checks, determines seat configuration and establishes valid sensing/control conditions before enabling cancellation output. Active attenuation is not credited until initialization completes successfully.&lt;/p&gt;&#10;">
                <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region" id="fc820e8f-f92c-435f-92a0-b49b0670e9a4" name="region"/>
              </ownedStates>
              <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State" id="fff292ee-17dc-4c87-81b8-1c7ae39c9bf5" name="Seated ANC Active" description="&lt;p&gt;[BASE] The seated active-control configuration is enabled. Structural reference signals and ear-side residual measurements support bounded local ANC using the seated headrest secondary sources.&lt;/p&gt;&#10;">
                <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region" id="34029c20-61b1-4cdb-a07a-713f71001956" name="region"/>
              </ownedStates>
              <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State" id="684092ea-e41c-4706-b851-b3fe45e99624" name="Bed-Mode ANC Active" description="&lt;p&gt;[BASE] The lie-flat/reclined active-control configuration is enabled. Control is handed to the bed/headboard secondary transducer array because the passenger-ear position leaves the seated headrest quiet zone.&lt;/p&gt;&#10;">
                <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region" id="38d5e1e0-d774-47ab-ab9f-2aa6b142726b" name="region"/>
              </ownedStates>
              <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State" id="bffbdba2-9cd5-4e00-84ff-f18b3ed0f78d" name="ANC Degraded / Limited" description="&lt;p&gt;[BASE] A non-critical ANC anomaly is present. The controller remains bounded through measures such as adaptation freeze, output limiting or feedback disable while system health continues to be monitored. Passive HACC protection remains available.&lt;/p&gt;&#10;">
                <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region" id="34a3565f-a3d5-4a15-b5e2-fb6e6b6c7153" name="region"/>
              </ownedStates>
              <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State" id="355f8aa8-9d0e-468a-945e-3e8ab5d2c32d" name="ANC Muted – Fail Passive" description="&lt;p&gt;[BASE] Active acoustic output is muted following a critical fault, instability condition, crew disable command or equivalent unsafe condition. The HACC reverts to passive acoustic protection with no ANC attenuation credit.&lt;/p&gt;&#10;">
                <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region" id="0b568316-f1fd-44c5-a86b-3aa57599c966" name="region"/>
              </ownedStates>
              <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State" id="5588f151-8d71-4b42-a1d0-fb4c030b0c68" name="ANC Disabled – Passive Only" description="&lt;p&gt;[BASE] Active noise cancellation is disabled, unavailable or not yet commanded. The passive HACC enclosure, dominant-bay treatment and resonator remain available; no active attenuation credit is taken.&lt;/p&gt;&#10;">
                <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region" id="7da01a38-e9b2-4b85-bfbb-221055ebd9e0" name="region"/>
              </ownedStates>
              <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State" id="f5f200f7-ff85-46ae-898f-cc2e77b6f809" name="Maintenance / Reset" description="&lt;p&gt;[BASE] The ANC subsystem is held in a safe non-credit state while diagnostics, maintenance, reset or post-maintenance checks are performed. Return to active operation requires successful health validation.&lt;/p&gt;&#10;">
                <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region" id="28f4c83b-fc07-4f7a-a64c-ddc036fdee76" name="region"/>
              </ownedStates>
              <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition" id="89d144b5-a693-4942-a502-87ca8482a13f" name="Default" triggerDescription="" source="#5ca77ee1-88d6-4b16-8899-09979f6432e8" target="#5588f151-8d71-4b42-a1d0-fb4c030b0c68"/>
