          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation" id="44a50691-2960-478e-8219-02c5749b3cdc" targetElement="#7aa9ce73-ae05-4023-9825-60b983839f26" sourceElement="#647c7136-9474-41bc-ae53-14bf944bd905"/>
          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation" id="9696f804-4bdb-4e19-acab-02c703c9703f" targetElement="#89ada3a0-11a6-492b-8573-53d0f3be693a" sourceElement="#647c7136-9474-41bc-ae53-14bf944bd905"/>
          <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation" id="4746d2a6-f94e-5ad9-b750-18364b5b8dfb" targetElement="#1682092f-2552-50bd-826f-c3128f7c1fec" sourceElement="#647c7136-9474-41bc-ae53-14bf944bd905"/>
