        <ownedSystemComponents xsi:type="org.polarsys.capella.core.data.ctx:SystemComponent" id="647c7136-9474-41bc-ae53-14bf944bd905" name="Hybrid Acoustic Comfort Cell (HACC)" description="&lt;p&gt;&lt;strong&gt;[BASE]&lt;/strong&gt; System of interest: passive HACC enclosure, tuned resonator and dual-mode active acoustic-control layer.&lt;/p&gt;&#10;">
          <ownedPropertyValues xsi:type="org.polarsys.capella.core.data.capellacore:StringPropertyValue" id="f9638e36-83f7-5a70-8b5f-d83977d31751" name="Origin" value="BASE"/>
